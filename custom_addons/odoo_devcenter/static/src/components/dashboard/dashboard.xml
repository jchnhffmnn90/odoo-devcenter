<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_devcenter.Dashboard" owl="1">
        <div class="o_devcenter_dashboard container-fluid py-4 h-100 d-flex flex-column">
            <h1 class="mb-4">Odoo DevCenter Dashboard</h1>
            
            <ul class="nav nav-tabs mb-4" id="devcenterTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="metrics-tab" data-bs-toggle="tab" data-bs-target="#metrics" type="button" role="tab" aria-controls="metrics" aria-selected="true" t-on-click="() => this.changeTab('metrics')">Metrics</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="logs-tab" data-bs-toggle="tab" data-bs-target="#logs" type="button" role="tab" aria-controls="logs" aria-selected="false" t-on-click="() => this.changeTab('logs')">Logs</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tests-tab" data-bs-toggle="tab" data-bs-target="#tests" type="button" role="tab" aria-controls="tests" aria-selected="false" t-on-click="() => this.changeTab('tests')">Test Runner</button>
                </li>
            </ul>
            
            <div class="tab-content flex-grow-1" id="devcenterTabsContent">
                <!-- METRICS TAB -->
                <div class="tab-pane fade show active" id="metrics" role="tabpanel" aria-labelledby="metrics-tab" t-if="state.activeTab === 'metrics'">
                    <t t-if="state.loadingMetrics">
                        <div class="alert alert-info">Loading metrics...</div>
                    </t>
                    <t t-else="">
                        <div class="row">
                            <!-- Odoo Metrics -->
                            <div class="col-md-4">
                                <div class="card shadow-sm mb-4">
                                    <div class="card-header bg-primary text-white">
                                        <h5 class="mb-0">Odoo Process</h5>
                                    </div>
                                    <div class="card-body">
                                        <ul class="list-group list-group-flush">
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                CPU
                                                <span class="badge bg-secondary rounded-pill"><t t-esc="state.metrics.odoo.cpu"/> %</span>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                RAM
                                                <span class="badge bg-secondary rounded-pill"><t t-esc="state.metrics.odoo.mem"/> MB</span>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                Disk I/O (R/W)
                                                <span class="badge bg-secondary rounded-pill"><t t-esc="state.metrics.odoo.read_mb"/> / <t t-esc="state.metrics.odoo.write_mb"/> MB</span>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                Files / Conns
                                                <span class="badge bg-secondary rounded-pill"><t t-esc="state.metrics.odoo.open_files"/> / <t t-esc="state.metrics.odoo.connections"/></span>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <!-- Postgres Metrics -->
                            <div class="col-md-4">
                                <div class="card shadow-sm mb-4">
                                    <div class="card-header bg-success text-white">
                                        <h5 class="mb-0">PostgreSQL Process</h5>
                                    </div>
                                    <div class="card-body">
                                        <ul class="list-group list-group-flush">
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                CPU
                                                <span class="badge bg-secondary rounded-pill"><t t-esc="state.metrics.postgres.cpu"/> %</span>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                RAM
                                                <span class="badge bg-secondary rounded-pill"><t t-esc="state.metrics.postgres.mem"/> MB</span>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                Disk I/O (R/W)
                                                <span class="badge bg-secondary rounded-pill"><t t-esc="state.metrics.postgres.read_mb"/> / <t t-esc="state.metrics.postgres.write_mb"/> MB</span>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                Files / Conns
                                                <span class="badge bg-secondary rounded-pill"><t t-esc="state.metrics.postgres.open_files"/> / <t t-esc="state.metrics.postgres.connections"/></span>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <!-- System Metrics -->
                            <div class="col-md-4">
                                <div class="card shadow-sm mb-4">
                                    <div class="card-header bg-info text-white">
                                        <h5 class="mb-0">System Overall</h5>
                                    </div>
                                    <div class="card-body">
                                        <ul class="list-group list-group-flush">
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                System CPU
                                                <span class="badge bg-secondary rounded-pill"><t t-esc="state.metrics.system.cpu"/> %</span>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                System RAM
                                                <span class="badge bg-secondary rounded-pill"><t t-esc="state.metrics.system.ram"/> %</span>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- LOGS TAB -->
                <div class="tab-pane fade show active" id="logs" role="tabpanel" aria-labelledby="logs-tab" t-if="state.activeTab === 'logs'">
                    <div class="d-flex justify-content-between mb-2">
                        <h4>Live Logs</h4>
                        <button class="btn btn-outline-secondary btn-sm" t-on-click="fetchLogs">Refresh manually</button>
                    </div>
                    <pre class="bg-dark text-light p-3 rounded" style="height: 60vh; overflow-y: scroll; font-size: 0.85em;"><t t-esc="state.logs"/></pre>
                </div>

                <!-- TESTS TAB -->
                <div class="tab-pane fade show active" id="tests" role="tabpanel" aria-labelledby="tests-tab" t-if="state.activeTab === 'tests'">
                    <div class="mb-3">
                        <label class="form-label">Module to test:</label>
                        <div class="input-group">
                            <input type="text" class="form-control" t-model="state.testModule" />
                            <button class="btn btn-primary" t-on-click="runTests" t-att-disabled="state.testing">
                                <t t-if="state.testing">
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    Running...
                                </t>
                                <t t-else="">Run Tests</t>
                            </button>
                        </div>
                    </div>
                    <t t-if="state.testOutput">
                        <h5>Result (Code: <t t-esc="state.testReturnCode"/>)</h5>
                        <pre class="bg-dark text-light p-3 rounded" style="max-height: 50vh; overflow-y: scroll; font-size: 0.85em;"><t t-esc="state.testOutput"/></pre>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
